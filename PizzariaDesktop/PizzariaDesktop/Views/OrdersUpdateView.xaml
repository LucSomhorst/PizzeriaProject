<UserControl x:Class="PizzariaDesktop.Views.OrdersUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PizzariaDesktop.Views"
             xmlns:viewmodels="clr-namespace:PizzariaDesktop.ViewModels" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <d:UserControl.DataContext>
        <viewmodels:OrderUpdateViewModel/>
    </d:UserControl.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBox Text="{Binding Order.Date, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Naam"
                     Margin="0,0,0,10"
                     IsEnabled="False"/>
            <ComboBox ItemsSource="{Binding OrderStatuses}"
                      SelectedItem="{Binding Order.Status, Mode=TwoWay}"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="Orderstatus"
                      Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
            <Button Content="Store" Command="{Binding StoreCommand}" Background="LimeGreen" Foreground="White" Margin="8,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Background="Blue" Foreground="White" Margin="8,0"/>
        </StackPanel>
    </Grid>
</UserControl>
